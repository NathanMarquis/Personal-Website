/*
  Cloudflare Pages custom headers (applies to all routes).

  Bootstrap 5.3.3 CSS + JS are SELF-HOSTED in /assets/ (pinned versions),
  so 'self' covers them and the page still makes zero third-party requests.
  Only two scripts exist on the site: bootstrap.bundle.min.js and site.js —
  both served from this domain, both auditable in the repo.

Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
X-Content-Type-Options: nosniff
Referrer-Policy: no-referrer
Permissions-Policy: camera=(), microphone=(), geolocation=()
